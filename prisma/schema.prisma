generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// ENUMS
// ========================================

enum UserRole {
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VolunteerStatus {
  ACTIVE
  INACTIVE
}

enum Classification {
  GREEN
  YELLOW
  RED
  BLACK
}

enum VerificationStatus {
  VERIFIED
  UNVERIFIED
}

enum VoteStatus {
  PENDING
  DONE
}

enum BoothStatus {
  NOT_STARTED
  VOTING_STARTED
  PROBLEM
}

enum AlertType {
  VOTING_SLOW
  VOLUNTEER_ISSUE
  BOOTH_ISSUE
  OTHER
}

enum ImportStatus {
  UPLOADED
  REVIEWING
  COMMITTED
  FAILED
}

// ========================================
// USER / ADMIN
// ========================================

model User {
  id       String     @id @default(uuid())
  name     String
  email    String     @unique
  password String
  role     UserRole   @default(ADMIN)
  status   UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importBatches ImportBatch[]
  auditLogs     AuditLog[]

  classificationChanges ClassificationHistory[] @relation("ClassificationChangedByUser")

  @@index([role])
  @@index([status])
}

// ========================================
// ASSEMBLY
// ========================================

model Assembly {
  id           String @id @default(uuid())
  number       String
  name         String
  district     String
  electionYear Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booths Booth[]
  voters Voter[]

  @@index([number])
  @@index([electionYear])
  @@index([isActive])
}

// ========================================
// BOOTH
// ========================================

model Booth {
  id          String  @id @default(uuid())
  boothNumber String
  name        String
  village     String?

  assemblyId String
  assembly   Assembly @relation(fields: [assemblyId], references: [id])

  volunteerId String?    @unique
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id])

  status BoothStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  voters Voter[]

  @@unique([assemblyId, boothNumber])
  @@index([assemblyId])
  @@index([village])
  @@index([status])
}

// ========================================
// VOLUNTEER
// ========================================

model Volunteer {
  id       String          @id @default(uuid())
  name     String
  mobile   String          @unique
  password String
  status   VolunteerStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booth Booth?

  classificationHistory ClassificationHistory[]

  auditLogs AuditLog[]

  @@index([status])
}

// ========================================
// VOTER
// ========================================

model Voter {
  id String @id @default(uuid())

  // ========================================
  // OFFICIAL / EXCEL DATA
  // ========================================

  epic String

  name      String
  nameHindi String?

  fatherName      String?
  fatherNameHindi String?

  motherName  String?
  husbandName String?

  gender      String?
  age         Int?
  dateOfBirth String?

  houseNumber String?
  village     String?

  // ========================================
  // ELECTORAL DATA
  // ========================================

  assemblyNumber     String?
  partNumber         String?
  partSerial         String?
  pollingStationName String?

  // ========================================
  // ASSEMBLY
  // ========================================

  assemblyId String
  assembly   Assembly @relation(fields: [assemblyId], references: [id])

  // ========================================
  // BOOTH
  // ========================================

  boothId String
  booth   Booth  @relation(fields: [boothId], references: [id])

  // ========================================
  // FIELD TEAM DATA
  // ========================================

  mobile String?

  verification   VerificationStatus @default(UNVERIFIED)
  classification Classification?

  // ========================================
  // ELECTION DAY
  // ========================================

  voteStatus VoteStatus @default(PENDING)

  // ========================================
  // TIMESTAMPS
  // ========================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========================================
  // HISTORY / AUDIT
  // ========================================

  classificationHistory ClassificationHistory[]
  auditLogs             AuditLog[]

  // ========================================
  // CONSTRAINTS
  // ========================================

  // ========================================
  // INDEXES
  // ========================================

  @@unique([assemblyId, epic])
  @@index([epic])
  @@index([name])
  @@index([mobile])
  @@index([houseNumber])
  @@index([boothId])
  @@index([village])
  @@index([classification])
  @@index([verification])
  @@index([gender])
  @@index([age])
  @@index([partNumber])
}

// ========================================
// CLASSIFICATION HISTORY
// ========================================

model ClassificationHistory {
  id String @id @default(uuid())

  voterId String
  voter   Voter  @relation(fields: [voterId], references: [id])

  oldValue Classification?
  newValue Classification

  // ========================================
  // VOLUNTEER ACTOR
  // ========================================

  changedById String?
  changedBy   Volunteer? @relation(fields: [changedById], references: [id])

  // ========================================
  // ADMIN ACTOR
  // ========================================

  changedByUserId String?
  changedByUser   User?   @relation("ClassificationChangedByUser", fields: [changedByUserId], references: [id])

  changedAt DateTime @default(now())

  @@index([voterId])
  @@index([changedById])
  @@index([changedByUserId])
  @@index([changedAt])
}

// ========================================
// IMPORT BATCH
// ========================================

model ImportBatch {
  id String @id @default(uuid())

  fileName String
  fileType String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  status ImportStatus @default(UPLOADED)

  totalRows     Int @default(0)
  validRows     Int @default(0)
  duplicateRows Int @default(0)
  errorRows     Int @default(0)
  importedRows  Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  errors ImportError[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
}

// ========================================
// IMPORT ERROR
// ========================================

model ImportError {
  id String @id @default(uuid())

  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id])

  rowNumber    Int
  rawData      Json
  errorMessage String

  createdAt DateTime @default(now())

  @@index([batchId])
}

// ========================================
// AUDIT LOG
// ========================================

model AuditLog {
  id String @id @default(uuid())

  action   String
  entity   String
  entityId String?

  details Json?

  // ========================================
  // ADMIN / USER
  // ========================================

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // ========================================
  // VOLUNTEER
  // ========================================

  volunteerId String?
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id])

  // ========================================
  // VOTER
  // ========================================

  voterId String?
  voter   Voter?  @relation(fields: [voterId], references: [id])

  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([volunteerId])
  @@index([voterId])
  @@index([createdAt])
}


// ========================================
// SYSTEM SETTINGS
// ========================================

model SystemSettings {
  id String @id @default(uuid())

  // ========================================
  // BOOTH STRENGTH
  // ========================================

  strongGreenPercent   Float @default(55)
  moderateGreenPercent Float @default(40)

  // ========================================
  // YELLOW OPPORTUNITY
  // ========================================

  highOpportunityYellow   Float @default(15)
  mediumOpportunityYellow Float @default(8)

  // ========================================
  // DATA CONFIDENCE
  // ========================================

  highVerification   Float @default(80)
  mediumVerification Float @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
